{
  "name": "@mandaterail/sdk",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "TypeScript HTTP client stubs for MandateRail demo-api, AC2 bridge, and console (OpenAPI-aligned)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "example:live": "tsx examples/live-testnet.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "algosdk": "^3.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@mandaterail/core": "workspace:*"
  }
}
