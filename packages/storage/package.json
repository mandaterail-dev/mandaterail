{
  "name": "@mandaterail/storage",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Postgres / Redis shared-state backends for MandateRail (Phase 2 T3). Internal AI review (eng hygiene).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:services": "bash ../../scripts/with-state-services.sh vitest run",
    "import-json": "tsx src/import-cli.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "spend": "tsx src/spend-cli.ts"
  },
  "dependencies": {
    "@mandaterail/core": "workspace:*",
    "@mandaterail/schema": "workspace:*",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "algosdk": "^3.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
