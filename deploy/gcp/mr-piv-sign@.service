# GCP variant of deploy/signer/mr-piv-sign@.service. R43-P2-4: one instance per accepted connection; fd 0/1 = the connection. MR_SIGNER_UID is filled at image build.
[Unit]
Description=mr-piv-sign helper (one request)
# rev 15 (GCP): the key is a Cloud KMS key version (CloudKmsBackend). No USB device, no PIN credential. The helper
# is the ONLY process that may reach the metadata server token endpoint and Cloud KMS (nftables skuid mr-piv).
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mr-piv
Group=mr-piv
StandardInput=socket
StandardOutput=socket
StandardError=journal
# R77-P3-2: install deploy/gcp/cloudkms.mainnet.json (MainNet) or a TestNet copy of cloudkms.example.json at this path
Environment=MR_PIV_BACKEND=cloudkms MR_KMS_CONFIG=/etc/mr-piv/cloudkms.mainnet.json
ExecStart=/usr/local/bin/mr-peercred-gate @MR_SIGNER_UID@ /usr/local/bin/mr-piv-sign --stdio
TimeoutStartSec=30
ProtectSystem=strict
ReadWritePaths=/var/lib/mr-piv
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# network only to the metadata server (token, and DNS) and Private Google Access (private.googleapis.com VIP);
# nftables enforces the same per uid
IPAddressDeny=any
IPAddressAllow=127.0.0.53/32 169.254.169.254/32 199.36.153.8/30
RestrictAddressFamilies=AF_UNIX AF_INET
PrivateDevices=yes
DevicePolicy=closed
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug
SystemCallArchitectures=native
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
UMask=0077
