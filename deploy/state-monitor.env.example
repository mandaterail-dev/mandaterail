# /etc/mandaterail/state-monitor.env  (root:root 0600; read by systemd, never by the app user)
DATABASE_URL=postgres://mr_monitor:<password>@127.0.0.1:5433/mandaterail
NETWORK=testnet
# Required, comma-separated; empty is a config error (exit 1), never "healthy".
# R22-P3-4: these URLs are logged and sent in the pager body: they must hold NO secrets
# (no tokens in path/query, no user:pass@). Each must have a unique origin+path.
MONITOR_HEALTH_URLS=https://mr-api.example/health,https://mr-bridge.example/health,https://mr-console.example/health
# Optional pager (R21-P3-1). HTTP POST on every alert. Treated as a secret; never printed.
#   json  (default): {"text": "...", "alert": {...}}  (Slack incoming webhooks read "text")
#   slack: {"text": "..."}
#   ntfy : text/plain body + Title/Priority/Tags headers (POST to https://ntfy.sh/<topic>)
# Unset = the monitor logs "no pager configured" on every run.
#MONITOR_PAGER_WEBHOOK_URL=https://hooks.slack.com/services/...
#MONITOR_PAGER_FORMAT=slack

# R65-P3-4 / R66-P3-3: off-host anchor chain of the append-only tables (MainNet: required, or the monitor pages).
# The prefix, minimum sequence, retention floor (>= 365 d) and anchor public key are pinned in
# deploy/integrity-manifest.json ("anchor"); the prefix below must equal the pin.
#MONITOR_ANCHOR_B2_ENDPOINT=https://s3.<region>.backblazeb2.com
#MONITOR_ANCHOR_B2_REGION=<region>
#MONITOR_ANCHOR_B2_BUCKET=<object-lock bucket>
#MONITOR_ANCHOR_B2_PREFIX=mr-monitor-anchor/mainnet/
#MONITOR_ANCHOR_B2_RETAIN_DAYS=400
#MONITOR_ANCHOR_B2_KEY_ID=<from the secret store, never here>
#MONITOR_ANCHOR_B2_APP_KEY=<from the secret store, never here>
# Signing key OFF the DB host: a Cloud KMS EC_SIGN_ED25519 key version (useToSign only for this host's SA).
#MONITOR_ANCHOR_KMS_KEY=projects/<project>/locations/<loc>/keyRings/<ring>/cryptoKeys/<key>/cryptoKeyVersions/1
# TestNet only: MONITOR_ANCHOR_SIGNING_KEY_FILE (software Ed25519 PEM) + MONITOR_ANCHOR_PUBKEY (base64 raw 32 bytes)
