# MandateRail environment

NODE_ENV=development

# Demo API
DEMO_API_PORT=8787
# Default bind is 127.0.0.1 (loopback). Non-loopback emits a startup warning.
# Do not use 0.0.0.0 unless you understand the exposure and have auth in place.
DEMO_API_HOST=127.0.0.1

# Console (file-store — console-dev surface; default loopback)
CONSOLE_PORT=8788
CONSOLE_HOST=127.0.0.1
# Console limits (clamped; out-of-range values refuse startup)
# CONSOLE_RATE_PER_IP=30          # 1-120 requests/min per client
# CONSOLE_RATE_GLOBAL=300         # 1-800 requests/min, >= per-IP
# CONSOLE_MAX_BODY_BYTES=16384    # 1024-65536 (413 above)
# CONSOLE_MAX_MANDATES=1000       # 1-10000 (503 store_full at cap)
# CONSOLE_DATA_DIR=./data         # JSON file store directory
# CONSOLE_CHALLENGE_AUDIENCE=mandaterail-console  # separate from the bridge audience
# Console signed-challenge also needs OPERATOR_ATTESTATION_MODE, OPERATOR_ALLOWLIST,
# OPERATOR_SIGNDATA_DOMAIN and CORS_ORIGINS (see the OperatorAuth section below).
# Live TestNet console: https://mr-console.8-221-97-26.sslip.io (behind Caddy).

# Shared by ac2-bridge and console (clamped; out-of-range values refuse startup)
# AC2_BRIDGE_TRUSTED_PROXY_HOPS=0     # 0 = off (default), max 5. Exact number of trusted proxies (Caddy = 1).
#                                     # Only keys rate limits on X-Forwarded-For; never grants localhost trust.
# OPERATOR_CHALLENGE_RATE_PER_IP=30   # 1-120 challenges/min per client
# OPERATOR_CHALLENGE_RATE_GLOBAL=600  # 1-800 challenges/min, >= per-IP

# ac2-bridge queue and /sign limits (clamped)
# AC2_BRIDGE_MAX_PENDING=1000            # 1-10000 queued + retained items
# AC2_BRIDGE_MAX_PENDING_PER_CLIENT=50   # 1-10000, <= MAX_PENDING
# AC2_BRIDGE_PENDING_TTL_MS=900000       # 60000-86400000, pending -> expired
# AC2_BRIDGE_RETENTION_MS=600000         # 60000-86400000, finalized items evicted after
# AC2_BRIDGE_SIGN_RATE_PER_MIN=60        # 1-600 POST /sign global
# AC2_BRIDGE_SIGN_RATE_PER_CLIENT=10     # 1-600, <= global

# GoPlausible facilitator (TestNet + MainNet host)
GOPLAUSIBLE_BASE_URL=https://facilitator.goplausible.xyz

# Algorand TestNet CAIP-2 (required when insecure lab flags are on)
NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=

# USDC TestNet ASA (6 decimals)
USDC_ASA_ID=10458941

# Merchant receive-only address (Algorand payTo) — must be opted into USDC.
# Distinct from the payer wallet below.
MERCHANT_ADDRESS=

# GoPlausible fee payer (from GET /supported)
FEE_PAYER=ZMFK2OI7ZBD2U27ISERZC4S6LKM6WMFJPZQ4MYNJDZ2VNBNMBA67RA22AA

# Price for demo paid resource (human USDC)
PRICE_USDC=0.01

# Payer wallet for scripts/e2e-paid.ts and LocalEd25519Signer (NEVER commit real mnemonics)
# ALGORAND_MNEMONIC=

# AC2 signing mode: local (mnemonic) | bridge (HttpAc2BridgeSigner → AC2_BRIDGE_URL)
AC2_MODE=local
# AC2_BRIDGE_URL=http://127.0.0.1:8790

# ac2-bridge (apps/ac2-bridge) — DEFAULT BIND LOOPBACK
AC2_BRIDGE_PORT=8790
AC2_BRIDGE_HOST=127.0.0.1
# Operator token for POST /approve /reject (and manual /sign). Prefer set for any non-toy use.
# AC2_OPERATOR_TOKEN=
# AC2_BRIDGE_AUTO_LOCAL=true
# AC2_PAIRED=false

# Explicit lab/CI consent. ALLOW_INSECURE_DEV itself requires TestNet NETWORK
# or the process exits. Also required (with TestNet) for AC2_BRIDGE_AUTO_LOCAL /
# DEV_ALLOW_UNSIGNED. Loopback tokenless OperatorAuth bypass needs all of:
# ALLOW_INSECURE_DEV=1 + TestNet NETWORK + token unset (never with ALLOW_MAINNET).
# MainNet NETWORK or ALLOW_MAINNET=1 requires OPERATOR_ATTESTATION_MODE=signed-challenge
# (token-lab refused) + OPERATOR_ALLOWLIST + OPERATOR_SIGNDATA_DOMAIN at startup.
# OperatorAttestation: signed-challenge | token-lab (default: signed-challenge on MainNet, else token-lab)
# OPERATOR_ATTESTATION_MODE=signed-challenge
# Comma-separated Algorand operator addresses allowed to sign challenges
# OPERATOR_ALLOWLIST=
# OPERATOR_CHALLENGE_TTL_MS=120000
# REQUIRED for every signed-challenge deployment (any network / bind / hops):
# ARC-60 signData origin domain (the console origin, e.g. mandaterail.pages.dev)
# Hosted console:
# OPERATOR_SIGNDATA_DOMAIN=mandaterail.pages.dev
# Local console (Vite dev server):
# OPERATOR_SIGNDATA_DOMAIN=localhost:5173
# ALLOW_INSECURE_DEV=1

# Optional receipt store path (default: apps/demo-api/data/receipts.json)
# RECEIPTS_PATH=

# Fail closed: never fake settle. Leave unset/false in production.
DEV_ALLOW_UNSIGNED=false

# Local UX only — never use in production
# DEMO_MOCK_FACILITATOR=false

# Planned merchant API key prefixes (validation required at verify time):
#   mr_test_…  TestNet only
#   mr_live_…  MainNet only


# CORS allowlist (comma-separated exact origins). Empty = no CORS headers; localhost SPA must proxy.
# Local SPA:
# CORS_ORIGINS=http://localhost:5173
# Live console (Cloudflare Pages) when SPA browser-calls demo-api / ac2-bridge — coordinate with Webdesigner; do not flip Pages from eng:
# CORS_ORIGINS=https://mandaterail.pages.dev
# Multiple origins (comma-separated):
# CORS_ORIGINS=http://localhost:5173,https://mandaterail.pages.dev

# MainNet is never default. Required together with MainNet NETWORK before mr_live_ keys are accepted.
# ALLOW_MAINNET=1

# Web SPA (apps/web) — Vite bake-time vars
# VITE_DEMO_API_URL=http://127.0.0.1:8787
# VITE_AC2_BRIDGE_URL=http://127.0.0.1:8790
# VITE_CONSOLE_API_URL=http://127.0.0.1:8788
# VITE_USE_MOCKS=true
# VITE_USE_API_MOCKS=true
# VITE_WALLET_MOCKS=false
# Optional WalletConnect Cloud project id (empty = omit WalletConnect from picker)
# VITE_WALLETCONNECT_PROJECT_ID=
# token-lab only (local TestNet): SPA Approve/Deny token. NEVER on public Pages — use signed-challenge (wallet-signed) there.
# VITE_AC2_OPERATOR_TOKEN=
