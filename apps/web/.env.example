VITE_DEMO_API_URL=http://127.0.0.1:8787
VITE_AC2_BRIDGE_URL=http://127.0.0.1:8790
VITE_CONSOLE_API_URL=http://127.0.0.1:8788
VITE_USE_MOCKS=true
VITE_USE_API_MOCKS=true
VITE_WALLET_MOCKS=false
# Optional WalletConnect Cloud project id (enables WalletConnect in the picker)
# VITE_WALLETCONNECT_PROJECT_ID=

# OperatorAuth for AC2 bridge (GET /pending, Approve/Deny).
# Bridge OPERATOR_ATTESTATION_MODE=signed-challenge (required on MainNet; use on
# Pages): the console fetches /operator/challenge and signs with the connected
# wallet (signData / ARC-60, e.g. Lute) or a pasted offline algosdk.signBytes
# signature. No operator secret in the SPA — leave VITE_AC2_OPERATOR_TOKEN unset.
# token-lab (local TestNet only): optionally set to match AC2_OPERATOR_TOKEN.
# Do NOT put mnemonics here.
# VITE_AC2_OPERATOR_TOKEN=
